{
  "name": "gugu-ai-visual-studio",
  "version": "0.1.0",
  "private": true,
  "description": "GuGu AI Visual Studio - LAN team workspace for AI image creation, editing, portraits, characters, and 3D staging",
  "type": "commonjs",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "test": "node --test test/*.test.js",
    "clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-project.ps1",
    "clean:deep": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-project.ps1 -IncludeDependencies",
    "build:character": "npm --prefix modules/character-studio run build",
    "check:character": "npm --prefix modules/character-studio run check"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
